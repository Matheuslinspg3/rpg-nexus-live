# Cloudflare Environment Variables
# Copy this file to .env or .dev.vars for local development

# Database Configuration
# Replace with your actual D1 database ID from Cloudflare Dashboard
# DATABASE_ID=your-d1-database-id-here

# R2 Configuration
# Bucket name is defined in wrangler.jsonc
# No additional configuration needed for R2

# Session Configuration (optional - defaults are secure)
# SESSION_SECRET=generate-a-random-string-for-session-encryption

# Development Configuration
# WRANGLER_LOG_PATH=.wrangler/logs
# MINIFLARE_REGISTRY_PATH=.wrangler/registry

# Production URLs (configured after deployment)
# PRODUCTION_URL=https://your-domain.com
